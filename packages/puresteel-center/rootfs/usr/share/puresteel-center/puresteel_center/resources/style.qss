QMainWindow,QWidget#Root{background:#f4f6f8;color:#17212b;font-family:"Noto Sans",sans-serif;font-size:14px}
QFrame#Sidebar{background:#ffffff;border-right:1px solid #d8dee6}
QLabel#BrandText{background:transparent;color:#17212b;font-size:18px;font-weight:800}
QListWidget#Navigation{background:transparent;color:#51606f;border:none;outline:none}
QListWidget#Navigation::item{background:transparent;border-radius:9px;padding-left:14px;margin:1px}
QListWidget#Navigation::item:hover{background:#eef3f8;color:#17212b}
QListWidget#Navigation::item:selected{background:#dcecf9;color:#10253a;font-weight:800}
QFrame#LanguageBox{background:#f7f9fb;border:1px solid #d8dee6;border-radius:11px}
QLabel#SidebarCaption{background:transparent;color:#6b7785;font-size:11px;font-weight:700}
QPushButton#LanguageButton{background:#fff;color:#4d5c6b;border:1px solid #ccd5df;border-radius:7px;padding:7px;font-weight:800}
QPushButton#LanguageButton:checked{background:#dcecf9;color:#10253a;border-color:#9dc7e8}
QLabel#VersionLabel{background:transparent;color:#7b8794;font-size:11px}
QStackedWidget#Pages,QWidget#ContentPage{background:#f4f6f8}
QFrame#HeroPanel,QFrame#Card{background:#fff;border:1px solid #d8dee6;border-radius:16px}
QFrame#Card:hover{background:#fafdff;border-color:#a9c8e1}
QLabel#Eyebrow,QLabel#CardNumber{background:transparent;color:#3478a8;font-size:11px;font-weight:800}
QLabel#PageTitle{background:transparent;color:#17212b;font-size:34px;font-weight:800}
QLabel#Lead,QLabel#CardText{background:transparent;color:#5d6b78}
QLabel#CardTitle{background:transparent;color:#1f2b36;font-size:17px;font-weight:800}
QPushButton#PrimaryButton{background:#2f78a8;color:#fff;border:none;border-radius:9px;padding:10px 16px;font-weight:800}
QPushButton#PrimaryButton:hover{background:#25678f}
QPushButton#SecondaryButton{background:#fff;color:#275f86;border:1px solid #9fc3dd;border-radius:9px;padding:10px 16px;font-weight:700}
QPushButton#SecondaryButton:hover{background:#eef7fd}
QLabel#StatusLabel{background:transparent;color:#617486}
QFrame#Notice{background:#f1f7fb;border:1px solid #c8deee;border-radius:11px}
QFrame#Notice QLabel{background:transparent;color:#496476}
QListWidget#DataList,QListWidget#UpdateList,QTextEdit#ReportText,QTextEdit,QTableWidget#DataTable,QTabWidget::pane{
 background:#fff;color:#24313d;border:1px solid #d8dee6;border-radius:12px;outline:none}
QListWidget#DataList::item,QListWidget#UpdateList::item{min-height:28px;padding-left:6px}
QTableWidget#DataTable{gridline-color:#e0e6ec;selection-background-color:#dbeefb;selection-color:#17212b}
QHeaderView::section{background:#eef2f6;color:#384858;border:none;border-right:1px solid #d8dee6;padding:8px;font-weight:700}
QLineEdit,QComboBox{background:#fff;color:#17212b;border:1px solid #cbd4dd;border-radius:8px;padding:8px;selection-background-color:#cce7f7}
QCheckBox{color:#26333f;spacing:8px}
QTabBar::tab{background:#eef2f6;color:#617182;border:1px solid #d8dee6;padding:9px 16px}
QTabBar::tab:selected{background:#fff;color:#1b4f73}
QScrollBar:vertical{background:#eef2f6;width:10px}
QScrollBar::handle:vertical{background:#bac7d2;min-height:30px;border-radius:5px}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0}
