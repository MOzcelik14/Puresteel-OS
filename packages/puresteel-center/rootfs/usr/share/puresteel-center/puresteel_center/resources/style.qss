/* Puresteel Center: native Plasma-inspired, light-first UI; no forced dark canvas. */
QMainWindow,QWidget#Root{background:#f5f8fc;color:#1b2e42;font-family:"Noto Sans",sans-serif;font-size:13px}
QFrame#Sidebar{background:#edf3f9;border-right:1px solid #d8e3ee}
QLabel#BrandText{background:transparent;color:#143350;font-size:18px;font-weight:800}
QListWidget#Navigation{background:transparent;color:#38556f;border:none;outline:none}
QListWidget#Navigation::item{background:transparent;border-radius:9px;padding-left:14px;margin:1px}
QListWidget#Navigation::item:hover{background:#dceafa;color:#163e62}
QListWidget#Navigation::item:selected{background:#d0e4fa;color:#114a80;font-weight:800}
QFrame#LanguageBox{background:#fff;border:1px solid #dae5ef;border-radius:11px}
QLabel#SidebarCaption{background:transparent;color:#5c758e;font-size:11px;font-weight:700}
QPushButton#LanguageButton{background:#f4f8fc;color:#3f627f;border:1px solid #dae5ef;border-radius:7px;padding:7px;font-weight:800}
QPushButton#LanguageButton:checked{background:#2778c7;color:#fff;border-color:#2778c7}
QLabel#VersionLabel{background:transparent;color:#627e98;font-size:11px}
QStackedWidget#Pages,QWidget#ContentPage{background:#f5f8fc}
QFrame#HeroPanel{background:#fff;border:1px solid #d9e5f0;border-radius:18px}
QLabel#Eyebrow{background:transparent;color:#2571b5;font-size:11px;font-weight:800}
QLabel#PageTitle{background:transparent;color:#183b59;font-size:33px;font-weight:800}
QLabel#Lead{background:transparent;color:#526b83;font-size:15px}
QLabel#HeroLogo{background:transparent}
QFrame#Card{background:#fff;border:1px solid #d9e5f0;border-radius:14px}
QFrame#Card:hover{background:#f5faff;border-color:#9ec5eb}
QLabel#CardNumber{background:transparent;color:#2574b8;font-size:11px;font-weight:800}
QLabel#CardTitle{background:transparent;color:#203e58;font-size:17px;font-weight:800}
QLabel#CardText{background:transparent;color:#58718a}
QPushButton#PrimaryButton{background:#287bc9;color:#fff;border:none;border-radius:9px;padding:10px 16px;font-weight:800}
QPushButton#PrimaryButton:hover{background:#155e9e}
QPushButton#PrimaryButton:disabled{background:#b5c9db;color:#eee}
QPushButton#SecondaryButton{background:#f0f6fc;color:#215783;border:1px solid #b9d4ec;border-radius:9px;padding:10px 16px;font-weight:700}
QPushButton#SecondaryButton:hover{background:#dfedfb}
QPushButton#SecondaryButton:disabled{color:#8296a8;background:#eef2f7}
QLabel#StatusLabel{background:transparent;color:#476a87}
QFrame#Notice{background:#eff6fd;border:1px solid #c6ddee;border-radius:11px}
QFrame#Notice QLabel{background:transparent;color:#385a76}
QListWidget#DataList,QListWidget#UpdateList,QTextEdit#ReportText,QTextEdit,QTableWidget#DataTable,QTabWidget::pane{
 background:#fff;color:#253f57;border:1px solid #d6e4f0;border-radius:12px;outline:none}
QListWidget#DataList::item,QListWidget#UpdateList::item{min-height:28px;padding-left:6px}
QTableWidget#DataTable{gridline-color:#e4edf5;selection-background-color:#d9ebfc;selection-color:#163f61}
QHeaderView::section{background:#eef5fb;color:#2c506f;border:none;border-right:1px solid #d5e4f0;padding:8px;font-weight:700}
QLineEdit,QComboBox{background:#fff;color:#253f57;border:1px solid #c5d9eb;border-radius:8px;padding:8px;selection-background-color:#a7d3f5}
QCheckBox{color:#253f57;spacing:8px}
QTabBar::tab{background:#f1f6fb;color:#56748e;border:1px solid #d6e4f0;padding:9px 16px}
QTabBar::tab:selected{background:#dceafa;color:#1d5685}
QScrollBar:vertical{background:#f5f8fc;width:10px}
QScrollBar::handle:vertical{background:#b3cbe0;min-height:30px;border-radius:5px}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0}
