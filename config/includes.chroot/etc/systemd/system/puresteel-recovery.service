[Unit]
Description=Puresteel Recovery Console
ConditionKernelCommandLine=puresteel.recovery=1
After=local-fs.target
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/local/sbin/puresteel-recovery --boot-menu
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
