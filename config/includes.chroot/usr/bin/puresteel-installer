#!/bin/sh
# Only use this launcher in Puresteel's ephemeral live installer session.
set -eu
BACKUP=/etc/fstab.orig.calamares
moved=0
authorized=0

cleanup() {
    if [ "$authorized" -eq 1 ] && command -v xhost >/dev/null 2>&1; then
        xhost -si:localuser:root >/dev/null 2>&1 || true
        authorized=0
    fi
    if [ "$moved" -eq 1 ] && [ -e "$BACKUP" ]; then
        sudo mv -- "$BACKUP" /etc/fstab || echo "Could not restore /etc/fstab from $BACKUP" >&2
        moved=0
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if [ -e "$BACKUP" ]; then
    echo "An earlier installer run left $BACKUP. Resolve it before relaunching." >&2
    exit 1
fi
if [ -e /etc/fstab ]; then
    sudo mv -- /etc/fstab "$BACKUP"
    moved=1
fi

export QT_AUTO_SCREEN_SCALE_FACTOR=1
if command -v xhost >/dev/null 2>&1; then
    xhost +si:localuser:root >/dev/null
    authorized=1
fi
pkexec calamares
