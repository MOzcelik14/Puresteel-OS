#!/bin/sh
set -u

if [ "$(id -u)" -ne 0 ]; then
    echo "Puresteel Recovery must run as root." >&2
    exit 1
fi

LAST_UPDATE=/var/lib/puresteel/last-update-snapshot

pause() { printf '\nPress Enter to continue... '; read _answer; }
apt_repair() { echo "[Puresteel] Repairing package state..."; dpkg --configure -a && apt-get -f install; }
boot_repair() { echo "[Puresteel] Rebuilding initramfs and GRUB..."; update-initramfs -u -k all && update-grub; }
sddm_repair() { echo "[Puresteel] Restoring SDDM..."; command -v sddm >/dev/null 2>&1 && systemctl enable --force sddm.service && systemctl set-default graphical.target; }
nvidia_repair() {
    echo "[Puresteel] Rebuilding NVIDIA DKMS/initramfs..."
    dpkg --configure -a || return 1
    if command -v dkms >/dev/null 2>&1; then dkms autoinstall || return 1; fi
    update-initramfs -u -k all
}
perform() { "$@"; code=$?; if [ "$code" -ne 0 ]; then echo "[Puresteel] FAILED (exit $code). Review the output above."; fi; return "$code"; }

snapshot_list() {
    if command -v timeshift >/dev/null 2>&1; then timeshift --list || true; else echo "Timeshift is not installed."; fi
}

snapshot_restore() {
    if ! command -v timeshift >/dev/null 2>&1; then echo "Timeshift is not installed."; return; fi
    echo "This opens Timeshift's interactive restore flow. Review the target snapshot and disks carefully."
    printf 'Continue? [y/N] '; read answer
    case "$answer" in y|Y|yes|YES) perform timeshift --restore ;; *) echo "Restore cancelled." ;; esac
}

undo_last_update() {
    if [ ! -f "$LAST_UPDATE" ]; then
        echo "No verified pre-update marker exists. Choose a snapshot manually."
        snapshot_restore
        return
    fi
    snapshot_id="$(python3 - "$LAST_UPDATE" <<'PY'
import json,re,sys
try:
    name=json.load(open(sys.argv[1],encoding="utf-8")).get("snapshot","")
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}",name):
        print(name)
except (OSError, ValueError, TypeError):
    pass
PY
)"
    if [ -z "$snapshot_id" ]; then
        echo "Pre-update marker is invalid. No automatic target selected."
        snapshot_restore
        return
    fi
    echo "Recorded pre-update snapshot: $snapshot_id"
    if ! timeshift --list --scripted 2>&1 | grep -Fq -- "$snapshot_id"; then
        echo "The recorded snapshot is not available. Restore cancelled."
        return
    fi
    echo "Review target filesystem and disks carefully in Timeshift."
    printf 'Restore this exact snapshot? [y/N] '; read answer
    case "$answer" in
        y|Y|yes|YES) perform timeshift --restore --snapshot "$snapshot_id" ;;
        *) echo "Restore cancelled." ;;
    esac
}

menu() {
    while :; do
        clear 2>/dev/null || true
        cat <<'EOF'
Puresteel Recovery
==================
1) Repair interrupted/broken packages
2) Rebuild initramfs and GRUB
3) Restore SDDM graphical boot
4) Rebuild NVIDIA DKMS/initramfs
5) Run Puresteel Doctor
6) List Timeshift snapshots
7) Restore a Timeshift snapshot
8) Undo last Puresteel update
9) Show installed/previous kernels
10) Open root shell
11) Reboot
12) Power off
0) Exit recovery menu
EOF
        printf '> '; read choice
        case "$choice" in
            1) perform apt_repair; pause ;;
            2) perform boot_repair; pause ;;
            3) perform sddm_repair; pause ;;
            4) perform nvidia_repair; pause ;;
            5) /usr/local/bin/puresteel-doctor 2>&1 | less -R 2>/dev/null || /usr/local/bin/puresteel-doctor; pause ;;
            6) snapshot_list; pause ;;
            7) snapshot_restore; pause ;;
            8) undo_last_update; pause ;;
            9) /usr/local/bin/puresteel-kernel; pause ;;
            10) /bin/bash ;;
            11) systemctl reboot; sleep 30 ;;
            12) systemctl poweroff; sleep 30 ;;
            0) return 0 ;;
            *) echo "Unknown choice"; sleep 1 ;;
        esac
    done
}

case "${1:-}" in
    --boot-menu|"") menu ;;
    apt) perform apt_repair ;;
    boot) perform boot_repair ;;
    sddm) perform sddm_repair ;;
    nvidia) perform nvidia_repair ;;
    doctor) /usr/local/bin/puresteel-doctor ;;
    snapshots) snapshot_list ;;
    restore) snapshot_restore ;;
    undo-update) undo_last_update ;;
    *) echo "Usage: puresteel-recovery [apt|boot|sddm|nvidia|doctor|snapshots|restore|undo-update|--boot-menu]"; exit 2 ;;
esac
