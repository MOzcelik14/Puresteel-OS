#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then echo 'Run as root.' >&2; exit 1; fi
cat <<'EOF'
Puresteel OEM preparation
This mode does NOT delete user accounts automatically.
It prepares the machine so the next desktop user receives Puresteel First Run.
For resale/provisioning, remove test accounts and personal data manually before shipping.
EOF
find /home -maxdepth 4 -path '*/.config/puresteel/first-run-complete' -delete 2>/dev/null || true
rm -f /etc/puresteel/hardware-mode /etc/puresteel/profile
systemd-machine-id-setup >/dev/null 2>&1 || true
echo 'OEM preparation markers reset.'
