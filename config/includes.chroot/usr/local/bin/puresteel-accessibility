#!/usr/bin/python3
import argparse,subprocess
p=argparse.ArgumentParser();p.add_argument('mode',choices=('status','large-text','normal-text','high-contrast','puresteel'));a=p.parse_args()
def gs(*x):return subprocess.run(['gsettings',*x],check=False).returncode
if a.mode=='status':
    subprocess.run(['gsettings','get','org.cinnamon.desktop.interface','text-scaling-factor']);subprocess.run(['gsettings','get','org.cinnamon.desktop.interface','gtk-theme']);raise SystemExit(0)
if a.mode=='large-text':raise SystemExit(gs('set','org.cinnamon.desktop.interface','text-scaling-factor','1.25'))
if a.mode=='normal-text':raise SystemExit(gs('set','org.cinnamon.desktop.interface','text-scaling-factor','1.0'))
if a.mode=='high-contrast':raise SystemExit(gs('set','org.cinnamon.desktop.interface','gtk-theme','HighContrast'))
raise SystemExit(gs('set','org.cinnamon.desktop.interface','gtk-theme','Puresteel-Dark'))
