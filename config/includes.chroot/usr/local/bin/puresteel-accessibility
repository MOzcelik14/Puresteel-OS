#!/usr/bin/python3
import argparse
import shutil
import subprocess

p=argparse.ArgumentParser()
p.add_argument("mode",choices=("status","large-text","normal-text","high-contrast","puresteel"))
a=p.parse_args()

def run(args):
    try:return subprocess.run(args,check=False).returncode
    except OSError:return 1

if a.mode=="status":
    for key in ("ColorScheme","XftDPI"):
        subprocess.run(["kreadconfig6","--file","kdeglobals","--group","General","--key",key],check=False)
    raise SystemExit(0)
if a.mode=="large-text":
    raise SystemExit(run(["kwriteconfig6","--file","kdeglobals","--group","General","--key","XftDPI","120"]))
if a.mode=="normal-text":
    raise SystemExit(run(["kwriteconfig6","--file","kdeglobals","--group","General","--delete","XftDPI"]))
if a.mode=="high-contrast":
    # KDE's shipped high-contrast scheme may differ by installation; do not invent one.
    print("Use System Settings > Colors & Themes > Colors to select a high-contrast scheme.")
    raise SystemExit(0)
raise SystemExit(subprocess.run(["/usr/local/bin/puresteel-apply-defaults"],check=False).returncode)
