#!/usr/bin/python3
import os,subprocess,sys
from pathlib import Path
from PySide6.QtCore import QUrl
from PySide6.QtGui import QDesktopServices
from PySide6.QtWidgets import QApplication,QGridLayout,QLabel,QMainWindow,QPushButton,QVBoxLayout,QWidget
TR=os.environ.get("LANG","").lower().startswith("tr")
def launch(args):
    try:subprocess.Popen(args,start_new_session=True)
    except OSError:pass
class W(QMainWindow):
    def __init__(self):
        super().__init__();self.setWindowTitle("Puresteel");self.resize(720,520);c=QWidget();self.setCentralWidget(c);l=QVBoxLayout(c)
        h=QLabel("Puresteel");h.setStyleSheet("font-size:30px;font-weight:700");l.addWidget(h)
        l.addWidget(QLabel("Sistemine hoş geldin. KDE Plasma tabanlı Puresteel araçlarına buradan ulaşabilirsin." if TR else "Welcome. Access the KDE Plasma-based Puresteel tools here."))
        g=QGridLayout();l.addLayout(g)
        actions=[("Puresteel Center",["puresteel-center"]),("İlk Ayarlar" if TR else "First Run",["puresteel-first-run","--force"]),("Dil Ayarları" if TR else "Language Settings",["mintlocale"]),("Sistem Doktoru" if TR else "System Doctor",["puresteel-doctor-gui"]),("Anlık Görüntüler" if TR else "Snapshots",["puresteel-snapshots"])]
        for i,(n,c) in enumerate(actions):b=QPushButton(n);b.clicked.connect(lambda _=False,x=c:launch(x));g.addWidget(b,i//2,i%2)
        b=QPushButton("Proje Sitesi" if TR else "Project Website");b.clicked.connect(lambda:QDesktopServices.openUrl(QUrl("https://mozcelik14.github.io/Puresteel-OS/")));g.addWidget(b,2,1)
app=QApplication(sys.argv);w=W();w.show();raise SystemExit(app.exec())
