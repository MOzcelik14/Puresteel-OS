#!/usr/bin/python3
import subprocess,sys
from PySide6.QtCore import QObject,QThread,Signal,Slot
from PySide6.QtWidgets import QApplication,QInputDialog,QLabel,QMainWindow,QMessageBox,QPushButton,QTextEdit,QVBoxLayout,QWidget
HELPER="/usr/lib/puresteel-center/puresteel-helper"
class Worker(QObject):
 done=Signal(int,str)
 def __init__(self,a,args):super().__init__();self.a=a;self.args=args
 @Slot()
 def run(self):
  try:p=subprocess.run(["pkexec",HELPER,self.a,*self.args],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=3600,check=False);self.done.emit(p.returncode,p.stdout)
  except Exception as e:self.done.emit(1,str(e))
class W(QMainWindow):
 def __init__(self):
  super().__init__();self.resize(820,560);c=QWidget();self.setCentralWidget(c);l=QVBoxLayout(c);self.status=QLabel();l.addWidget(self.status);self.out=QTextEdit();self.out.setReadOnly(True);l.addWidget(self.out);self.refresh=QPushButton("Refresh");self.create=QPushButton("Create snapshot");l.addWidget(self.refresh);l.addWidget(self.create);self.refresh.clicked.connect(lambda:self.go("snapshot-list",[]));self.create.clicked.connect(self.new);self.thread=None;self.go("snapshot-list",[])
 def go(self,a,args):
  if self.thread:return
  self.refresh.setEnabled(False);self.create.setEnabled(False);self.thread=QThread(self);self.worker=Worker(a,args);self.worker.moveToThread(self.thread);self.thread.started.connect(self.worker.run);self.worker.done.connect(lambda c,o:self.done(a,c,o));self.worker.done.connect(self.thread.quit);self.thread.finished.connect(self.finish);self.thread.start()
 def new(self):
  text,ok=QInputDialog.getText(self,"Create snapshot","Comment:",text="Puresteel manual snapshot")
  if ok:self.go("snapshot-create",[text or "Puresteel manual snapshot"])
 def done(self,a,c,o):
  self.out.setPlainText(o);self.status.setText("Done." if c==0 else f"Failed ({c}).")
  if c!=0:QMessageBox.warning(self,"Puresteel Snapshots",o[-4000:] or "Operation failed")
 def finish(self):self.thread=None;self.worker=None;self.refresh.setEnabled(True);self.create.setEnabled(True)
app=QApplication(sys.argv);w=W();w.show();raise SystemExit(app.exec())
