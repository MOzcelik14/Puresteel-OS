#!/usr/bin/python3
import shutil
import subprocess
from pathlib import Path

WALLPAPER = Path("/usr/share/backgrounds/puresteel/wallpaper.png")

def run(args):
    try:
        return subprocess.run(args, check=False).returncode
    except OSError:
        return 1

def main():
    rc = 0
    if shutil.which("lookandfeeltool"):
        rc |= run(["lookandfeeltool", "-a", "org.kde.breeze.desktop"])
    if shutil.which("kwriteconfig6"):
        for group, key, value in (
            ("General", "ColorScheme", "BreezeLight"),
            ("Icons", "Theme", "breeze"),
            ("KDE", "widgetStyle", "Breeze"),
        ):
            rc |= run(["kwriteconfig6", "--file", "kdeglobals", "--group", group, "--key", key, value])
    if WALLPAPER.is_file() and shutil.which("plasma-apply-wallpaperimage"):
        rc |= run(["plasma-apply-wallpaperimage", str(WALLPAPER)])
    print("Puresteel KDE defaults applied." if rc == 0 else "Some KDE defaults could not be applied.")
    return rc

if __name__ == "__main__":
    raise SystemExit(main())
