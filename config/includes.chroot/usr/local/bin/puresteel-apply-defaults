#!/usr/bin/python3
import subprocess


def schema_exists(schema):
    p = subprocess.run(["gsettings", "list-schemas"], text=True, stdout=subprocess.PIPE, check=False)
    return schema in p.stdout.splitlines()


def key_exists(schema, key):
    if not schema_exists(schema):
        return False
    p = subprocess.run(["gsettings", "list-keys", schema], text=True, stdout=subprocess.PIPE, check=False)
    return key in p.stdout.splitlines()


def setv(schema, key, value):
    if key_exists(schema, key):
        subprocess.run(["gsettings", "set", schema, key, value], check=False)
        return True
    return False


def main():
    changed = 0
    changed += setv("org.cinnamon.desktop.interface", "gtk-theme", "Puresteel-Dark")
    changed += setv("org.cinnamon.desktop.interface", "icon-theme", "Puresteel")
    changed += setv("org.cinnamon.desktop.background", "picture-uri", "file:///usr/share/backgrounds/puresteel/wallpaper.png")
    changed += setv("org.cinnamon.desktop.background", "picture-options", "zoom")
    changed += setv("org.cinnamon.desktop.default-applications.terminal", "exec", "gnome-terminal")
    changed += setv("org.cinnamon.theme", "name", "Puresteel-Dark")
    changed += setv("org.cinnamon.desktop.sound", "theme-name", "Puresteel")
    changed += setv("org.cinnamon", "favorite-apps", "['puresteel-center.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop']")
    changed += setv("org.cinnamon", "panel-edit-mode", "false")
    print(f"Puresteel defaults applied ({changed} supported settings).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
