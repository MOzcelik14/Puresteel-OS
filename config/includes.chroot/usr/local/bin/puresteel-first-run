#!/usr/bin/python3
import os,shutil,subprocess,sys
from pathlib import Path
from PySide6.QtWidgets import QApplication,QCheckBox,QComboBox,QLabel,QMessageBox,QVBoxLayout,QWizard,QWizardPage

if Path("/run/live/medium").exists() and "--force" not in sys.argv: raise SystemExit(0)
MARKER=Path.home()/".config/puresteel/first-run-complete"
if MARKER.exists() and "--force" not in sys.argv: raise SystemExit(0)

def run(args):
    try:return subprocess.run(args,check=False).returncode
    except OSError:return 1

class Wizard(QWizard):
    def __init__(self):
        super().__init__();self.setWindowTitle("Puresteel First Run");self.resize(720,520)
        p=QWizardPage();p.setTitle("Dil / Language");l=QVBoxLayout(p);self.lang=QComboBox()
        self.lang.addItem("Türkçe (Türkiye)","tr_TR.UTF-8");self.lang.addItem("English (United States)","en_US.UTF-8")
        self.lang.setCurrentIndex(0 if os.environ.get("LANG","").startswith("tr") else 1);l.addWidget(self.lang);self.addPage(p)
        p=QWizardPage();p.setTitle("Görünüm / Appearance");l=QVBoxLayout(p)
        l.addWidget(QLabel("Puresteel varsayılanı Breeze Light'tır. / Puresteel defaults to Breeze Light."))
        self.theme=QComboBox();self.theme.addItem("Breeze Light","light");self.theme.addItem("Breeze Dark","dark");l.addWidget(self.theme)
        self.wall=QComboBox()
        for f,n in (("wallpaper.png","Puresteel Default"),("puresteel-light.png","Puresteel Light"),("puresteel-midnight.svg","Puresteel Midnight"),("puresteel-orbit.svg","Puresteel Orbit"),("puresteel-horizon.svg","Puresteel Horizon")):self.wall.addItem(n,f)
        l.addWidget(self.wall);self.addPage(p)
        p=QWizardPage();p.setTitle("Profil / Profile");l=QVBoxLayout(p);self.profile=QComboBox()
        for k,n in (("balanced","Balanced"),("gaming","Gaming"),("creator","Creator"),("battery","Battery")):self.profile.addItem(n,k)
        l.addWidget(self.profile);self.addPage(p)
        p=QWizardPage();p.setTitle("Tamam / Finish");l=QVBoxLayout(p)
        l.addWidget(QLabel("KWallet, SDDM giriş parolanızla PAM üzerinden otomatik açılır.\nWi-Fi parolası her açılışta yeniden sorulmamalıdır."))
        self.center=QCheckBox("Bitince Puresteel Center'ı aç / Open Puresteel Center");self.center.setChecked(True);l.addWidget(self.center);self.addPage(p)

    def accept(self):
        failures=[]
        theme=self.theme.currentData();laf="org.kde.breeze.desktop" if theme=="light" else "org.kde.breezedark.desktop"
        if shutil.which("lookandfeeltool") and run(["lookandfeeltool","-a",laf]):failures.append("theme")
        scheme="BreezeLight" if theme=="light" else "BreezeDark"
        if shutil.which("kwriteconfig6") and run(["kwriteconfig6","--file","kdeglobals","--group","General","--key","ColorScheme",scheme]):failures.append("colors")
        wall=Path("/usr/share/backgrounds/puresteel")/self.wall.currentData()
        if not wall.is_file() or (shutil.which("plasma-apply-wallpaperimage") and run(["plasma-apply-wallpaperimage",str(wall)])):failures.append("wallpaper")
        locale=self.lang.currentData()
        if locale and not os.environ.get("LANG","").startswith(locale.split(".")[0]):
            if run(["pkexec","/usr/local/bin/mintlocale","--apply",locale]):failures.append("language")
        if run(["pkexec","/usr/lib/puresteel-center/puresteel-helper","profile-apply",self.profile.currentData()]):failures.append("profile")
        if failures:
            QMessageBox.warning(self,"Puresteel","Some settings failed: "+", ".join(failures));return
        MARKER.parent.mkdir(parents=True,exist_ok=True);MARKER.write_text("done\n")
        if self.center.isChecked() and shutil.which("puresteel-center"):subprocess.Popen(["puresteel-center"],start_new_session=True)
        super().accept()

app=QApplication(sys.argv);w=Wizard();w.show();raise SystemExit(app.exec())
