#!/usr/bin/python3
import subprocess, shutil

CRITICAL=("linux-image","linux-headers","nvidia","firmware-","grub","shim","systemd","initramfs")

def capture(cmd):
    try:
        p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=60,check=False)
        return p.returncode,p.stdout
    except Exception:
        return 1,""

code,out=capture(["apt","list","--upgradable"])
if code: raise SystemExit(0)
items=[]; critical=[]
for raw in out.splitlines():
    if "/" not in raw or raw.lower().startswith("listing"): continue
    name=raw.split("/",1)[0].strip()
    if not name: continue
    items.append(name)
    if name.startswith(CRITICAL): critical.append(name)
if not items: raise SystemExit(0)
body=f"{len(items)} update(s) available"
if critical: body+=f" · {len(critical)} critical system update(s)"
if shutil.which("notify-send"):
    subprocess.run(["notify-send","-i","software-update-available","Puresteel Updates",body],check=False)
