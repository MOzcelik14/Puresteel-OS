#!/usr/bin/python3
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote

if len(sys.argv) != 2:
    raise SystemExit("Usage: puresteel-open-admin PATH")
p = Path(sys.argv[1]).expanduser().resolve()
uri = "admin://" + quote(str(p), safe="/")
raise SystemExit(subprocess.call(["nemo", uri]))
