#!/usr/bin/python3
import subprocess,sys
from pathlib import Path
from PySide6.QtCore import QObject,QThread,Signal,Slot
from PySide6.QtWidgets import QApplication,QFileDialog,QHBoxLayout,QLabel,QMainWindow,QPushButton,QTextEdit,QVBoxLayout,QWidget
class Worker(QObject):
    done=Signal(int,str)
    def __init__(self,admin):super().__init__();self.admin=admin
    @Slot()
    def run(self):
        cmd=["/usr/local/bin/puresteel-doctor"];cmd=(["pkexec"]+cmd) if self.admin else cmd
        try:p=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=120,check=False);self.done.emit(p.returncode,p.stdout)
        except Exception as e:self.done.emit(1,str(e))
class W(QMainWindow):
    def __init__(self):
        super().__init__();self.resize(900,650);c=QWidget();self.setCentralWidget(c);l=QVBoxLayout(c);self.status=QLabel();l.addWidget(self.status);self.out=QTextEdit();self.out.setReadOnly(True);l.addWidget(self.out);r=QHBoxLayout();l.addLayout(r)
        for n,a in (("Refresh",False),("Run as administrator",True)):
            b=QPushButton(n);b.clicked.connect(lambda _=False,x=a:self.collect(x));r.addWidget(b)
        s=QPushButton("Save report…");s.clicked.connect(self.save);r.addWidget(s);self.thread=None;self.collect(False)
    def collect(self,admin):
        if self.thread:return
        self.status.setText("Collecting…");self.thread=QThread(self);self.worker=Worker(admin);self.worker.moveToThread(self.thread);self.thread.started.connect(self.worker.run);self.worker.done.connect(self.show);self.worker.done.connect(self.thread.quit);self.thread.finished.connect(self.finish);self.thread.start()
    def show(self,code,text):self.out.setPlainText(text);self.status.setText("Report ready." if code==0 else f"Doctor failed ({code}).")
    def finish(self):self.thread=None;self.worker=None
    def save(self):
        p,_=QFileDialog.getSaveFileName(self,"Save report",str(Path.home()/"puresteel-doctor.txt"))
        if p:Path(p).write_text(self.out.toPlainText())
app=QApplication(sys.argv);w=W();w.show();raise SystemExit(app.exec())
