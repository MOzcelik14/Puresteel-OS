#!/usr/bin/python3
import getpass
import os
import re
import socket
import subprocess
from pathlib import Path


def capture(args, timeout=20):
    try:
        p = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, check=False)
        return p.stdout.strip()
    except Exception as exc:
        return str(exc)


def redact(text):
    user = getpass.getuser()
    home = str(Path.home())
    host = socket.gethostname()
    text = text.replace(home, "~").replace(user, "<user>").replace(host, "<host>")
    text = re.sub(r"(?i)\b(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\b", "<mac>", text)
    text = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "<ip>", text)
    return text


def main():
    parts = []
    try:
        data = {}
        for line in Path("/etc/os-release").read_text(errors="ignore").splitlines():
            if "=" in line:
                k, v = line.split("=", 1); data[k] = v.strip('"')
        parts.append(data.get("PRETTY_NAME", "Puresteel"))
    except OSError:
        parts.append("Puresteel")
    parts.append(capture(["uname", "-srmo"]))
    if Path("/etc/puresteel/profile").exists():
        parts.append("Profile: " + Path("/etc/puresteel/profile").read_text().strip())
    if Path("/etc/puresteel/channel").exists():
        parts.append("Channel: " + Path("/etc/puresteel/channel").read_text().strip())
    if os.path.exists("/usr/local/bin/puresteel-doctor"):
        parts.append(capture(["/usr/local/bin/puresteel-doctor"], 45))
    print(redact("\n".join(parts)))
    print("\nSensitive usernames, home paths, hostnames, MAC and IPv4 addresses are redacted automatically.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
