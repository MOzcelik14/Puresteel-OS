#!/usr/bin/env python3
"""Apply Puresteel's KDE-native first-login defaults once per user."""
import os
import shutil
import subprocess
from pathlib import Path

MARKER = Path.home() / ".config/puresteel/kde-defaults-v1"
WALLPAPER = Path("/usr/share/backgrounds/puresteel/wallpaper.png")


def run(args):
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=30, check=False).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def main():
    if MARKER.exists():
        return 0
    failures = []
    if shutil.which("lookandfeeltool"):
        failures.append(run(["lookandfeeltool", "-a", "org.kde.breeze.desktop"]))
    if shutil.which("kwriteconfig6"):
        for group, key, value in (
            ("General", "ColorScheme", "BreezeLight"),
            ("Icons", "Theme", "breeze"),
            ("KDE", "widgetStyle", "Breeze"),
        ):
            failures.append(run(["kwriteconfig6", "--file", "kdeglobals",
                                 "--group", group, "--key", key, value]))
    if WALLPAPER.is_file() and shutil.which("plasma-apply-wallpaperimage"):
        failures.append(run(["plasma-apply-wallpaperimage", str(WALLPAPER)]))
    if any(failures):
        return 1
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("done\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
