#!/usr/bin/python3
"""Repair actions run off the GTK main loop; failures are never shown as success."""
import subprocess
import threading
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

HELPER = "/usr/lib/puresteel-center/puresteel-helper"
ACTIONS = [
    ("Broken packages", "repair-packages"),
    ("Initramfs + GRUB", "repair-boot"),
    ("LightDM graphical boot", "repair-lightdm"),
    ("NVIDIA DKMS/initramfs", "repair-nvidia"),
    ("Flatpak installation", "flatpak-repair"),
]


class RepairWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Puresteel Repair")
        self.set_default_size(680, 500)
        self.set_border_width(18)
        self.connect("destroy", Gtk.main_quit)
        self.buttons = []
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(body)
        heading = Gtk.Label()
        heading.set_markup("<span size='x-large' weight='bold'>Puresteel Repair</span>")
        heading.set_xalign(0)
        body.pack_start(heading, False, False, 0)
        self.status = Gtk.Label(label="Review each repair before running.")
        self.status.set_line_wrap(True)
        self.status.set_xalign(0)
        body.pack_start(self.status, False, False, 0)
        self.output = Gtk.TextView()
        self.output.set_editable(False)
        self.output.set_monospace(True)
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.output)
        body.pack_start(scroller, True, True, 0)
        for name, action in ACTIONS:
            button = Gtk.Button(label="Repair " + name)
            button.connect("clicked", self.start, name, action)
            body.pack_start(button, False, False, 0)
            self.buttons.append(button)

    def start(self, _button, label, action):
        question = Gtk.MessageDialog(
            transient_for=self, flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Run repair: " + label + "?",
        )
        accepted = question.run() == Gtk.ResponseType.YES
        question.destroy()
        if not accepted:
            return
        for button in self.buttons:
            button.set_sensitive(False)
        self.status.set_text("Repair running: " + label)
        threading.Thread(target=self.worker, args=(action,), daemon=True).start()

    def worker(self, action):
        try:
            result = subprocess.run(
                ["pkexec", HELPER, action],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                timeout=7200, check=False,
            )
            code, output = result.returncode, result.stdout
        except (OSError, subprocess.TimeoutExpired) as exc:
            code, output = 1, str(exc)
        GLib.idle_add(self.finished, code, output)

    def finished(self, code, output):
        self.output.get_buffer().set_text(
            output or ("Completed." if code == 0 else "Failed."))
        self.status.set_text("Repair completed." if code == 0 else
                             f"Repair FAILED (exit {code}). Review output.")
        for button in self.buttons:
            button.set_sensitive(True)
        return False


window = RepairWindow()
window.show_all()
Gtk.main()
