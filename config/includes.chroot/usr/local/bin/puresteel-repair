#!/usr/bin/python3
import subprocess,sys
from PySide6.QtCore import QObject,QThread,Signal,Slot
from PySide6.QtWidgets import QApplication,QLabel,QMainWindow,QMessageBox,QPushButton,QTextEdit,QVBoxLayout,QWidget
HELPER="/usr/lib/puresteel-center/puresteel-helper"
ACTIONS=[("Broken packages","repair-packages"),("Initramfs + GRUB","repair-boot"),("SDDM graphical boot","repair-sddm"),("NVIDIA DKMS/initramfs","repair-nvidia"),("Flatpak installation","flatpak-repair")]
class Worker(QObject):
 done=Signal(int,str)
 def __init__(self,a):super().__init__();self.a=a
 @Slot()
 def run(self):
  try:p=subprocess.run(["pkexec",HELPER,self.a],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=7200,check=False);self.done.emit(p.returncode,p.stdout)
  except Exception as e:self.done.emit(1,str(e))
class W(QMainWindow):
 def __init__(self):
  super().__init__();self.resize(700,520);c=QWidget();self.setCentralWidget(c);l=QVBoxLayout(c);self.status=QLabel("Choose a repair action.");l.addWidget(self.status);self.out=QTextEdit();self.out.setReadOnly(True);l.addWidget(self.out);self.buttons=[]
  for n,a in ACTIONS:b=QPushButton("Repair "+n);b.clicked.connect(lambda _=False,x=a,y=n:self.go(x,y));l.addWidget(b);self.buttons.append(b)
  self.thread=None
 def go(self,a,n):
  if self.thread or QMessageBox.question(self,"Puresteel Repair","Run repair: "+n+"?")!=QMessageBox.Yes:return
  for b in self.buttons:b.setEnabled(False)
  self.thread=QThread(self);self.worker=Worker(a);self.worker.moveToThread(self.thread);self.thread.started.connect(self.worker.run);self.worker.done.connect(self.done);self.worker.done.connect(self.thread.quit);self.thread.finished.connect(self.finish);self.thread.start()
 def done(self,c,o):self.out.setPlainText(o);self.status.setText("Repair completed." if c==0 else f"Repair FAILED ({c}).")
 def finish(self):self.thread=None;self.worker=None;[b.setEnabled(True) for b in self.buttons]
app=QApplication(sys.argv);w=W();w.show();raise SystemExit(app.exec())
