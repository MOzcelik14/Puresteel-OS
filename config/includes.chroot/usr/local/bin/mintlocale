#!/usr/bin/python3
import os,subprocess,sys
from pathlib import Path
ALLOWED={"en_US.UTF-8":("English (United States)","en_US:en"),"tr_TR.UTF-8":("Türkçe (Türkiye)","tr_TR:tr")}
def apply_locale(name):
    if name not in ALLOWED:return 2
    subprocess.run(["/usr/sbin/locale-gen",name],check=True)
    subprocess.run(["/usr/sbin/update-locale",f"LANG={name}",f"LANGUAGE={ALLOWED[name][1]}"],check=True);return 0
def current():
    p=Path("/etc/default/locale")
    if p.exists():
        for line in p.read_text(errors="ignore").splitlines():
            if line.startswith("LANG="):
                v=line.split("=",1)[1].strip().strip('"')
                if v in ALLOWED:return v
    return "tr_TR.UTF-8" if os.environ.get("LANG","").startswith("tr") else "en_US.UTF-8"
if len(sys.argv)==3 and sys.argv[1]=="--apply":
    if os.geteuid()!=0:raise SystemExit(1)
    raise SystemExit(apply_locale(sys.argv[2]))
from PySide6.QtWidgets import QApplication,QComboBox,QLabel,QMessageBox,QPushButton,QVBoxLayout,QWidget
app=QApplication(sys.argv);w=QWidget();w.setWindowTitle("Puresteel Language Settings");w.resize(460,220);l=QVBoxLayout(w)
l.addWidget(QLabel("System language / Sistem dili"));combo=QComboBox()
for k,(label,_) in ALLOWED.items():combo.addItem(label,k)
combo.setCurrentIndex(combo.findData(current()));l.addWidget(combo);status=QLabel();l.addWidget(status);b=QPushButton("Apply system-wide / Sisteme uygula");l.addWidget(b)
def go():
    b.setEnabled(False);rc=subprocess.run(["pkexec","/usr/local/bin/mintlocale","--apply",combo.currentData()],check=False).returncode
    status.setText("Done. Log out and back in. / Tamamlandı. Oturumu kapatıp açın." if rc==0 else "Language change failed / Dil değiştirilemedi");b.setEnabled(True)
b.clicked.connect(go);w.show();raise SystemExit(app.exec())
