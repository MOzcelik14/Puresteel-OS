#!/bin/sh
set -e
echo "[Puresteel] Configuring minimal KDE Plasma and SDDM..."
# Installed systems keep password login for KWallet/PAM.
# A boot=live-only unit prepares the ephemeral live login before SDDM.
mkdir -p /etc/sddm.conf.d
if [ -x /usr/bin/systemctl ]; then
    systemctl enable sddm.service
    systemctl enable puresteel-live-session.service
    systemctl set-default graphical.target
fi
if [ -x /usr/bin/update-alternatives ]; then
    update-alternatives --set default-displaymanager /usr/bin/sddm 2>/dev/null || true
fi
